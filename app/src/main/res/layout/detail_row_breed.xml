<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout style="@style/DetailRow">
        <TextView style="@style/DetailLabel" android:text="Giống" />
        <TextView android:id="@+id/tvDetailPetBreed" style="@style/DetailValue" android:text="Chưa rõ" />
    </LinearLayout>
    <View style="@style/DetailDivider" />
    <LinearLayout style="@style/DetailRow">
        <TextView style="@style/DetailLabel" android:text="Giới tính" />
        <TextView android:id="@+id/tvDetailPetGender" style="@style/DetailValue" android:text="Chưa xác định" />
    </LinearLayout>
    <View style="@style/DetailDivider" />
    <LinearLayout style="@style/DetailRow">
        <TextView style="@style/DetailLabel" android:text="Ngày sinh" />
        <TextView android:id="@+id/tvDetailPetBirthDate" style="@style/DetailValue" android:text="Chưa cập nhật" />
    </LinearLayout>
    <View style="@style/DetailDivider" />
    <LinearLayout style="@style/DetailRow">
        <TextView style="@style/DetailLabel" android:text="Màu sắc" />
        <TextView android:id="@+id/tvDetailPetColor" style="@style/DetailValue" android:text="Chưa cập nhật" />
    </LinearLayout>
    <View style="@style/DetailDivider" />
    <LinearLayout style="@style/DetailRow">
        <TextView style="@style/DetailLabel" android:text="Cân nặng" />
        <TextView android:id="@+id/tvDetailPetWeight" style="@style/DetailValue" android:text="Chưa cập nhật" />
    </LinearLayout>
</LinearLayout>
