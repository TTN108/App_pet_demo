<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <color name="accent">#319795</color>
    <color name="accent_orange">#DD6B20</color>
    <color name="accent_orange_light">#FFEDD5</color>
    <color name="background">#F8FAFC</color>
    <color name="banner_blue_light">#2B6CB0</color>
    <color name="bg_banner">#E2E8F0</color>
    <color name="bg_card">#FFFFFF</color>
    <color name="bg_card_secondary">#F1F5F9</color>
    <color name="bg_main">#F8FAFC</color>
    <color name="black">#FF000000</color>
    <color name="border">#E2E8F0</color>
    <color name="border_active">#2B6CB0</color>
    <color name="border_inactive">#E2E8F0</color>
    <color name="danger">#E53E3E</color>
    <color name="gallery_bg_1">#F0FDF4</color>
    <color name="gallery_bg_2">#FEFCE8</color>
    <color name="gallery_bg_3">#FEF2F2</color>
    <color name="primary">#2B6CB0</color>
    <color name="primary_blue">#2B6CB0</color>
    <color name="primary_blue_dark">#1A365D</color>
    <color name="primary_dark">#1A365D</color>
    <color name="surface">#FFFFFF</color>
    <color name="text_dark">#0F172A</color>
    <color name="text_gray">#64748B</color>
    <color name="text_muted">#94A3B8</color>
    <color name="text_primary">#1E293B</color>
    <color name="text_secondary">#64748B</color>
    <color name="text_white">#1E293B</color>
    <color name="white">#FFFFFFFF</color>
    <string name="app_name">App Pet Demo</string>
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="fontFamily">sans-serif</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="android:windowBackground">@color/background</item>
    </style>
    <style name="DetailDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/border</item>
    </style>
    <style name="DetailLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="DetailRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:minHeight">54dp</item>
    </style>
    <style name="DetailValue">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1.2</item>
        <item name="android:gravity">end</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="FormEditText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:paddingStart">13dp</item>
        <item name="android:paddingEnd">13dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:singleLine">false</item>
    </style>
    <style name="FormLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">15dp</item>
        <item name="android:layout_marginBottom">7dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="FormSpinner">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:paddingStart">9dp</item>
        <item name="android:paddingEnd">9dp</item>
        <item name="android:spinnerMode">dropdown</item>
    </style>
    <style name="Theme.AppPet" parent="AppTheme"/>
</resources>